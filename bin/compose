#!/usr/bin/env bash
# Fold each surface's per-service spec into ONE composite PER AUDIENCE (published/<audience>-api.json).
#
# A surface directory is named `<service>-<audience>` (e.g. appointments-api-public), so the audience is
# the segment after the final `-`. All specs sharing an audience compose into that audience's composite.
#
# Component and tag names are NOT prefixed -- the composite reads as one unified API, not a stitched-together
# set of services. A schema name shared by two or more specs of the same audience must therefore resolve to
# exactly ONE model:
#
#   identical shapes -> unified into a single schema. Annotations come from canonical/<audience>/<Name>.json
#                       when that overlay exists, otherwise from the first spec (with a warning).
#   divergent shapes -> HARD FAILURE. Two different shapes under one name in a published contract is a
#                       contract bug; it blocks the publish instead of being masked by a name prefix.
#
# Canonical overlays are per-audience by design -- canonical/<audience>/<Name>.json. There is deliberately
# NO cross-audience canonical directory and no fallback between audiences: surfaces evolve independently and
# must not be coupled through shared documentation.
#
# Portal navigation sections (x-tagGroups) are rebuilt from sections/<audience>.json rather than left as
# redocly's default, which names one group per source spec after that spec's info.title and so leaks service
# identity ("Symplast Appointments Public API") into the published contract. Section MEMBERSHIP is per TAG,
# not per spec, which is what lets several services share one section and one service span several. A tag's
# section comes from its own `x-domain` extension when the owning service emits one, else from that file's
# tagDomains fallback; a tag resolved by neither is a hard failure, because it would be missing from the
# portal's navigation entirely.
#
# An overlay may only restate ANNOTATIONS. Its shape is verified against the specs and a mismatch is a hard
# failure, so canonical/ can never become a place where the published contract drifts from what the services
# actually return.
#
# Portable to bash 3.2 (macOS system bash) on purpose, so the composer can be run locally exactly as CI runs
# it -- hence no associative arrays.
#
# Env:
#   COMPOSITE_VERSION  (required)  stamped into info.version of every composite
#   GITHUB_OUTPUT      (optional)  when set, `count` is written for the workflow's tagging gate
set -euo pipefail
shopt -s nullglob

# audience -> "Title|ServerUrl". Add a case when a new audience's specs land; an audience with specs but no
# case here is skipped (with a warning), never published with a wrong title/host.
audience_meta() {
  case "$1" in
    public) echo "Symplast Public API|https://api.symplast.com" ;;
    *)      return 1 ;;
  esac
}

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${COMPOSITE_VERSION:?COMPOSITE_VERSION must be set}"

STAGE_ROOT="$(mktemp -d)"
trap 'rm -rf "$STAGE_ROOT"' EXIT

# Composites are built HERE, not in published/, and moved into place only once every audience has succeeded.
# That keeps publication atomic: a schema conflict in any audience leaves published/ exactly as it was,
# instead of half-rewritten by the audiences that happened to compose before the failure.
OUT_STAGE="${STAGE_ROOT}/out"
mkdir -p "$OUT_STAGE"

# Annotation-insensitive form of a JSON Schema, used ONLY to compare shapes.
# Schema-aware on purpose: a blanket `walk(del(.description))` would ALSO delete a property *named*
# "description" (PaymentTypeLookup has one), silently making unequal shapes compare equal. This descends
# only into real schema positions, so property keys are never touched.
JQ_CANON_DEF='
def canon:
  if type == "object" then
      del(.description, .example, .examples, .title, .summary, .externalDocs, .deprecated)
    | with_entries(
        if (.key | IN("properties","patternProperties","definitions")) then
          .value |= with_entries(.value |= canon)
        elif (.key | IN("items","additionalProperties","not","if","then","else")) then
          .value |= (if type == "object" then canon else . end)
        elif (.key | IN("allOf","anyOf","oneOf","prefixItems")) then
          .value |= map(canon)
        else . end)
  else . end;'

canon_schema() { # <file> <schema-name> -> annotation-free shape of that schema on stdout
  jq -S --arg n "$2" "${JQ_CANON_DEF} .components.schemas[\$n] | canon" "$1"
}

errors=0
composed=0

# Discover the audiences that actually have specs today.
audiences="$(
  for dir in specs/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/openapi.json" ] || continue
    echo "${name##*-}"
  done | sort -u
)"
# An empty store is not an error: it means every surface was removed, and the publish step below then
# clears the orphaned composites so their REMOVAL is what gets committed.
if [ -z "$audiences" ]; then
  echo "No specs found under specs/*/openapi.json; nothing to compose."
fi

for aud in $audiences; do
  spec_files=( specs/*-"${aud}"/openapi.json )
  [ ${#spec_files[@]} -eq 0 ] && continue

  if ! meta="$(audience_meta "$aud")"; then
    echo "::warning::Audience '${aud}' has specs (${spec_files[*]}) but no audience_meta case (title/host) -- skipping. Add a case to publish it."
    continue
  fi

  echo "=== audience '${aud}': ${#spec_files[@]} spec(s)"
  stage="${STAGE_ROOT}/${aud}"
  mkdir -p "$stage"

  # Stage a working copy per service so shared-schema unification never mutates specs/.
  staged=()
  for f in "${spec_files[@]}"; do
    svc="$(basename "$(dirname "$f")")"
    cp "$f" "${stage}/${svc}.json"
    staged+=( "${stage}/${svc}.json" )
  done

  # --- Unify schema names shared by 2+ specs of this audience ---------------------------------------
  shared="$(for f in "${staged[@]}"; do jq -r '.components.schemas // {} | keys[]' "$f"; done | sort | uniq -d)"
  audience_errors=0

  if [ -n "$shared" ]; then
    while IFS= read -r schema; do
      [ -n "$schema" ] || continue

      # Which staged specs define it, and do their shapes agree?
      owners=() ; shapes=()
      for f in "${staged[@]}"; do
        if [ "$(jq --arg n "$schema" '.components.schemas // {} | has($n)' "$f")" = "true" ]; then
          owners+=( "$f" )
          shapes+=( "$(canon_schema "$f" "$schema")" )
        fi
      done

      divergent=0
      for s in "${shapes[@]}"; do
        [ "$s" = "${shapes[0]}" ] || divergent=1
      done

      if [ "$divergent" -eq 1 ]; then
        {
          echo "::error::Schema '${schema}' has DIVERGENT shapes across the '${aud}' specs:"
          for f in "${owners[@]}"; do echo "::error::    - $(basename "$f" .json)"; done
          echo "::error::  A published contract cannot expose two different shapes under one name."
          echo "::error::  Reconcile the schema upstream so the services agree, or rename one of them."
        } >&2
        audience_errors=$((audience_errors + 1))
        continue
      fi

      overlay="canonical/${aud}/${schema}.json"
      if [ -f "$overlay" ]; then
        # An overlay may restate annotations ONLY -- its shape must match what the services emit.
        if [ "$(jq -S "${JQ_CANON_DEF} canon" "$overlay")" != "${shapes[0]}" ]; then
          {
            echo "::error::Canonical overlay '${overlay}' does not match the shape the '${aud}' specs emit."
            echo "::error::  Overlays may restate annotations (description/example) only, never the shape."
            echo "::error::  Update the overlay to match the services, or fix the services."
          } >&2
          audience_errors=$((audience_errors + 1))
          continue
        fi
        winner="$(jq -c '.' "$overlay")"
        echo "  unified '${schema}' across ${#owners[@]} specs (annotations from ${overlay})"
      else
        winner="$(jq -c --arg n "$schema" '.components.schemas[$n]' "${owners[0]}")"
        echo "::warning::Schema '${schema}' is shared by ${#owners[@]} '${aud}' specs with identical shapes but has no canonical/${aud}/${schema}.json; its documentation was taken from $(basename "${owners[0]}" .json). Add the overlay to control it."
      fi

      # Make every copy byte-identical so redocly join de-duplicates them into a single component.
      for f in "${owners[@]}"; do
        tmp="$(mktemp)"
        jq --arg n "$schema" --argjson w "$winner" '.components.schemas[$n] = $w' "$f" > "$tmp"
        mv "$tmp" "$f"
      done
    done <<< "$shared"
  fi

  if [ "$audience_errors" -gt 0 ]; then
    errors=$((errors + audience_errors))
    continue
  fi

  # --- Join -----------------------------------------------------------------------------------------
  out="${OUT_STAGE}/${aud}-api.json"
  final="published/${aud}-api.json"
  if [ ${#staged[@]} -eq 1 ]; then
    # redocly join requires >= 2 inputs. With a single service the service spec IS the composite.
    echo "  single spec; copying through without join."
    cp "${staged[0]}" "$out"
  else
    # No prefix flags at all: shared components were unified above, so byte-identical definitions
    # de-duplicate. Services own distinct path prefixes and distinct tag names, so neither collides.
    # A collision that survived unification is a genuine contract conflict -- redocly exits non-zero and
    # we let it fail the build rather than papering over it with a prefix.
    echo "  joining ${#staged[@]} specs -> ${out}"
    npx --yes @redocly/cli@1 join "${staged[@]}" -o "$out" </dev/null
  fi

  # --- Portal navigation sections -------------------------------------------------------------------
  # Replace redocly's per-spec x-tagGroups with the audience's declared sections. Membership is resolved per
  # tag: the tag's own `x-domain` wins, else sections/<aud>.json's tagDomains fallback. The tag list is the
  # union of DECLARED tags and tags actually referenced by operations, so an operation carrying an undeclared
  # tag cannot slip through ungrouped. Declaration order is preserved within a section.
  sections_file="sections/${aud}.json"
  if [ ! -f "$sections_file" ]; then
    {
      echo "::error::Audience '${aud}' has no ${sections_file}, so its portal navigation sections are undefined."
      echo "::error::  Add it with the audience's ordered section names and, for surfaces not yet emitting"
      echo "::error::  x-domain on their tags, a tagDomains fallback map."
    } >&2
    errors=$((errors + 1))
    continue
  fi

  resolved="$(jq -n --slurpfile spec "$out" --slurpfile cfg "$sections_file" '
    ($spec[0]) as $s | ($cfg[0]) as $c
    | ($c.sections // []) as $order
    | ($c.tagDomains // {}) as $fallback
    | [$s.tags[]?.name] as $declared
    | ([$s.paths[]? | to_entries[] | .value.tags[]?] | unique) as $used
    | ($declared + [$used[] | select(. as $u | $declared | index($u) | not)]) as $all
    | [ $all[] as $t
        | { tag: $t,
            domain: ( ([$s.tags[]? | select(.name == $t) | .["x-domain"]] | map(select(. != null)) | first)
                      // $fallback[$t] ) } ] as $r
    | { unassigned: [ $r[] | select(.domain == null) | .tag ],
        unknown:    [ $r[] | .domain as $d | select($d != null and (($order | index($d)) == null)) | "\(.tag) -> \($d)" ] | unique,
        groups:     [ $order[] as $d | { name: $d, tags: [ $r[] | select(.domain == $d) | .tag ] } | select((.tags | length) > 0) ] }
  ')"

  unassigned="$(jq -r '.unassigned | join(", ")' <<< "$resolved")"
  unknown="$(jq -r '.unknown | join(", ")' <<< "$resolved")"

  if [ -n "$unassigned" ]; then
    {
      echo "::error::These '${aud}' tags belong to no section, so they would be missing from the portal navigation:"
      echo "::error::    ${unassigned}"
      echo "::error::  Either have the owning service emit x-domain on the tag, or add it to tagDomains in ${sections_file}."
    } >&2
    errors=$((errors + 1))
    continue
  fi
  if [ -n "$unknown" ]; then
    {
      echo "::error::These '${aud}' tags name a section that does not exist in ${sections_file}:"
      echo "::error::    ${unknown}"
      echo "::error::  Fix the typo, or add the section to that file's ordered \"sections\" list."
    } >&2
    errors=$((errors + 1))
    continue
  fi

  tmp="$(mktemp)"
  jq --argjson groups "$(jq -c '.groups' <<< "$resolved")" '
      .["x-tagGroups"] = $groups
    | if .tags then .tags |= map(del(.["x-domain"])) else . end' "$out" > "$tmp"
  mv "$tmp" "$out"
  echo "  sections: $(jq -r '[.groups[] | "\(.name)(\(.tags | length))"] | join("  ")' <<< "$resolved")"

  # Stamp the composite's identity + server + version, overriding whatever the source specs carry (build
  # defaults such as localhost/per-env hosts, and each service's own image-tag info.version). info.version
  # is THIS repo's nbgv version -- the composite's own version -- so it matches the immutable git tag the
  # same commit gets stamped with.
  IFS='|' read -r title server <<< "$meta"
  tmp="$(mktemp)"
  jq --arg t "$title" --arg s "$server" --arg v "$COMPOSITE_VERSION" \
     '.servers = [{ "url": $s }]
      | .info.title = $t
      | .info.version = $v
      | .info.description = ("The unified " + $t + " surface, composed from each service specification.")' \
     "$out" > "$tmp"
  mv "$tmp" "$out"

  echo "  composed ${final}:"
  jq '{ openapi, info, servers, pathCount: (.paths | keys | length), schemaCount: (.components.schemas // {} | keys | length) }' "$out"
  composed=$((composed + 1))
done

if [ "$errors" -gt 0 ]; then
  echo "::error::Compose failed with ${errors} unresolved schema conflict(s); published/ left untouched." >&2
  exit 1
fi

# Every audience composed cleanly, so swap the staged composites into place. Clearing published/*-api.json
# first is what makes a removed audience/service leave no orphan behind (git add -A commits the deletion);
# with nullglob the move is a no-op when the store is empty, so an emptied store clears published/ and its
# removals are what get committed.
mkdir -p published
rm -f published/*-api.json
for staged_out in "$OUT_STAGE"/*-api.json; do
  mv "$staged_out" "published/$(basename "$staged_out")"
done

if [ -n "${GITHUB_OUTPUT:-}" ]; then echo "count=${composed}" >> "$GITHUB_OUTPUT"; fi
echo "Composed ${composed} composite(s)."
