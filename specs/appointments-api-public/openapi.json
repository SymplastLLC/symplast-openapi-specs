{
  "openapi": "3.1.1",
  "info": {
    "title": "Symplast Appointments Public API",
    "description": "Authenticated, cursor-paged public read surface for appointment data.",
    "version": "1.92.17"
  },
  "servers": [
    {
      "url": "https://api.symplast.com"
    }
  ],
  "paths": {
    "/v1/scheduling/appointments": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "List appointments",
        "description": "**Required scope:** `scheduling.appointments.read`\n\nReturns a cursor-paged change feed of the caller's tenant appointments.\n\nOrdered by `updatedAt` ascending, then `id` ascending. Resume with `updatedSince` or follow `next`.\n\nDelivery is at-least-once, so dedupe on `id`. A `cursor` carries the `updatedSince` it was issued\nunder; sending a different `updatedSince` with it is rejected with `cursor-filter-mismatch`.",
        "operationId": "GetAppointments",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of items per page, from 1 to 500. Defaults to 100.",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor for the next page, taken from the previous page's `nextCursor`. Pass it back unchanged; omit it for the first page. The `next` link already carries it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedSince",
            "in": "query",
            "description": "Only items changed at or after this instant (inclusive), as an ISO-8601 date-time; a value with no offset is UTC. To resume a sync, pass the largest `updatedAt` you have already received, or follow `next`. Omit it to start from the beginning of the feed.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponsePublicAppointment"
                },
                "example": {
                  "data": [
                    {
                      "id": 1024,
                      "updatedAt": "2026-01-15T14:30:00Z",
                      "startsAt": "2026-01-20T14:00:00Z",
                      "endsAt": "2026-01-20T14:30:00Z",
                      "durationMinutes": 30,
                      "status": {
                        "id": 5,
                        "description": "Confirmed"
                      },
                      "appointmentType": {
                        "id": 1,
                        "description": "Consultation"
                      },
                      "providerId": 42,
                      "locationId": 7,
                      "patientId": 88231,
                      "isDeleted": false,
                      "isCancelled": false
                    }
                  ],
                  "pageSize": 50,
                  "count": 1,
                  "hasMore": false,
                  "nextCursor": null,
                  "next": null
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/invalid-cursor",
                  "title": "Invalid cursor",
                  "status": 400,
                  "detail": "The supplied cursor could not be decoded.",
                  "code": "invalid-cursor"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/unauthenticated",
                  "title": "Unauthenticated",
                  "status": 401,
                  "detail": "A valid gateway token is required to access this resource.",
                  "code": "unauthenticated"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to do this. A token without the required scope gets an RFC 9457 problem with code `insufficient_scope`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/invalid-cursor",
                  "title": "Invalid cursor",
                  "status": 400,
                  "detail": "The supplied cursor could not be decoded.",
                  "code": "invalid-cursor"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/internal-error",
                  "title": "Internal server error",
                  "status": 500,
                  "detail": "An unexpected error occurred.",
                  "code": "internal-error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/scheduling/appointments/{id}": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "Get an appointment by id",
        "description": "**Required scope:** `scheduling.appointments.read`\n\nReturns a single appointment by its identifier, scoped to the caller's tenant. An id that\ndoes not exist in the tenant returns 404 (a cross-tenant id is indistinguishable from a\nmissing one — no disclosure).",
        "operationId": "GetAppointmentById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The appointment identifier, unique within the caller's tenant.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAppointment"
                },
                "example": {
                  "id": 1024,
                  "updatedAt": "2026-01-15T14:30:00Z",
                  "startsAt": "2026-01-20T14:00:00Z",
                  "endsAt": "2026-01-20T14:30:00Z",
                  "durationMinutes": 30,
                  "status": {
                    "id": 5,
                    "description": "Confirmed"
                  },
                  "appointmentType": {
                    "id": 1,
                    "description": "Consultation"
                  },
                  "providerId": 42,
                  "locationId": 7,
                  "patientId": 88231,
                  "isDeleted": false,
                  "isCancelled": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/unauthenticated",
                  "title": "Unauthenticated",
                  "status": 401,
                  "detail": "A valid gateway token is required to access this resource.",
                  "code": "unauthenticated"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/not-found",
                  "title": "Not found",
                  "status": 404,
                  "detail": "The requested appointment does not exist in this tenant.",
                  "code": "not-found"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not allowed to do this. A token without the required scope gets an RFC 9457 problem with code `insufficient_scope`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/invalid-cursor",
                  "title": "Invalid cursor",
                  "status": 400,
                  "detail": "The supplied cursor could not be decoded.",
                  "code": "invalid-cursor"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/internal-error",
                  "title": "Internal server error",
                  "status": 500,
                  "detail": "An unexpected error occurred.",
                  "code": "internal-error"
                }
              }
            }
          }
        }
      }
    },
