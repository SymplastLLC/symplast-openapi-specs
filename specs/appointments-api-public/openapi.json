              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentStageLookup"
                  }
                },
                "example": [
                  {
                    "stageType": "Scheduled",
                    "description": "Scheduled stage",
                    "statusIds": [
                      5,
                      6
                    ]
                  }
                ]
              }
            }
          },
          "403": {
