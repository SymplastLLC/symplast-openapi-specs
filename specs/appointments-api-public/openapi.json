  "components": {
    "schemas": {
      "AppointmentPurposeLookup": {
        "required": [
          "id",
          "description",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The appointment purpose identifier. Not stable across tenants.",
            "format": "int32",
            "example": 2
          },
          "description": {
            "type": "string",
            "description": "The purpose's display name.",
            "example": "New Patient"
          },
          "isDeleted": {
            "type": "boolean",
            "description": "Whether the purpose has been deleted. Deleted purposes are left out of the list, so this is `false` here.",
            "example": false
          }
        },
        "description": "An appointment purpose vocabulary entry (tenant-scoped).",
        "example": {
          "id": 2,
          "description": "New Patient",
          "isDeleted": false
        }
      },
      "AppointmentStageLookup": {
        "required": [
          "stageType",
          "description",
          "statusIds"
        ],
        "type": "object",
        "properties": {
          "stageType": {
            "type": "string",
            "description": "The stage's fixed key: `Unassigned`, `Scheduled`, `RemindersSent`, `Confirmed`, `Started`, `Occurred` or `NotOccurred`.",
            "example": "Scheduled"
          },
          "description": {
            "type": "string",
            "description": "The stage's display name, e.g. `Not Confirmed` for `RemindersSent`.",
            "example": "Scheduled stage"
          },
          "statusIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The ids of the tenant's statuses assigned to this stage (see `GET /v1/scheduling/appointment-statuses`). Empty when none are.",
            "example": [
              5,
              6
            ]
          }
        },
        "description": "An appointment stage vocabulary entry (couples to statuses).",
        "example": {
          "stageType": "Scheduled",
          "description": "Scheduled stage",
          "statusIds": [
            5,
            6
          ]
        }
      },
      "AppointmentStatusLookup": {
        "required": [
          "id",
          "name",
          "description",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The status identifier; matches `status.id` on an appointment and the `statusIds` of a stage. Not stable across tenants.",
            "format": "int32",
            "example": 5
          },
          "name": {
            "type": "string",
            "description": "The status's short name.",
            "example": "Confirmed"
          },
          "description": {
            "type": "string",
            "description": "The status's longer description.",
            "example": "Appointment confirmed by the patient"
          },
          "isDeleted": {
            "type": "boolean",
            "description": "Whether the status has been deleted. Deleted statuses are left out of the list, so this is `false` here.",
            "example": false
          }
        },
        "description": "An appointment status vocabulary entry from per-tenant `StatusMaster`.",
        "example": {
          "id": 5,
          "name": "Confirmed",
          "description": "Appointment confirmed by the patient",
          "isDeleted": false
        }
      },
      "AppointmentTypeLookup": {
        "required": [
          "id",
          "description",
          "durationInMinutes",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The appointment type identifier; matches `appointmentType.id` on an appointment. Not stable across tenants.",
            "format": "int32",
            "example": 1
          },
          "description": {
            "type": "string",
            "description": "The appointment type's display name.",
            "example": "Consultation"
          },
          "durationInMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The default length of an appointment of this type, in minutes; `null` when none is set.",
            "format": "int32",
            "example": 30
          },
          "isDeleted": {
            "type": "boolean",
            "description": "Whether the type has been deleted. Deleted types are left out of the list, so this is `false` here.",
            "example": false
          }
        },
        "description": "An appointment type vocabulary entry (tenant-scoped).",
        "example": {
          "id": 1,
          "description": "Consultation",
          "durationInMinutes": 30,
          "isDeleted": false
        }
      },
      "LookupRef": {
        "required": [
          "id",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The lookup identifier (tenant-scoped).",
            "format": "int32",
            "example": 5
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "The lookup description; `null` when the source description is null.",
            "example": "Confirmed"
          }
        },
        "description": "A tenant-scoped reference to a lookup value, exposed as a stable-per-tenant id plus its human\ndescription. Used for LookupRef? PublicAppointment.Status and\nLookupRef? PublicAppointment.AppointmentType. The id is NOT stable across tenants.",
        "example": {
          "id": 5,
          "description": "Confirmed"
        }
      },
      "PagedResponsePublicAppointment": {
        "required": [
          "data",
          "pageSize",
          "count",
          "hasMore"
        ],
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicAppointment"
            },
            "description": "The items in this page, in feed order. Empty when there are none.",
            "example": [
              {
                "id": 1024,
                "updatedAt": "2026-01-15T14:30:00Z",
                "startsAt": "2026-01-20T14:00:00Z",
                "endsAt": "2026-01-20T14:30:00Z",
                "durationMinutes": 30,
                "status": {
                  "id": 5,
                  "description": "Confirmed"
                },
                "appointmentType": {
                  "id": 1,
                  "description": "Consultation"
                },
                "providerId": 42,
                "locationId": 7,
                "patientId": 88231,
                "isDeleted": false,
                "isCancelled": false
              }
            ]
          },
          "pageSize": {
