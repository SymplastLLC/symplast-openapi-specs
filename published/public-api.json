      "Symplast_Legacy_Public_API_PublicLocation": {
        "required": [
          "id",
          "officeId",
          "name",
          "type",
          "address",
          "timeZone",
          "phone",
          "fax"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Stable identifier. This is the value an appointment's `locationId` carries.",
            "format": "int32"
          },
          "officeId": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The parent office. `null` in four cases: the FK is unset; the office row does not exist; the office\nis soft-deleted; or the office is <b>unstaffed</b> and therefore absent from `GET /v1/offices`. A\nnon-null value is guaranteed to resolve against `GET /v1/offices/{id}`.",
            "format": "int32"
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Location name."
          },
          "type": {
            "description": "Classification. Always present; inner fields may be `null`.",
            "$ref": "#/components/schemas/Symplast_Legacy_Public_API_PublicLocationType"
          },
          "address": {
            "description": "Postal address.",
            "$ref": "#/components/schemas/Symplast_Legacy_Public_API_PublicAddress"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ],
            "description": "IANA time zone id, e.g. `America/New_York`. `null` when the stored value cannot be resolved —\nnever a Windows id, and never a guess. A `null` here means any accompanying instant was interpreted\nas UTC."
          },
          "phone": {
            "type": [
              "null",
              "string"
            ],
            "description": "Premises phone number."
          },
          "fax": {
            "type": [
              "null",
              "string"
            ],
            "description": "Premises fax number."
          }
        },
        "description": "A physical location where the practice delivers care. Locations sit beneath offices.",
        "example": {
          "id": 8412,
          "officeId": 311,
          "name": "Downtown Surgical Suite",
          "type": {
            "code": "SURG",
            "description": "Surgical Center"
          },
          "address": {
            "line": "410 Market St, Suite 900",
            "line2": null,
            "city": "Philadelphia",
            "stateCode": "PA",
            "state": "Pennsylvania",
            "postalCode": "19106",
            "country": "United States"
          },
          "timeZone": "America/New_York",
          "phone": "+1-215-555-0142",
          "fax": null
        }
      },
      "Symplast_Legacy_Public_API_PublicLocationType": {
        "required": [
