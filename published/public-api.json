            "type": [
              "null",
              "string"
            ],
            "description": "Second address line. Always `null` in v1: no source model carries it."
          },
          "city": {
            "type": [
              "null",
              "string"
            ],
            "description": "City name."
          },
          "stateCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "Two-letter state code."
          },
          "state": {
            "type": [
              "null",
              "string"
            ],
            "description": "Full state name. `null` for offices, which do not resolve it."
          },
          "postalCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "Postal / ZIP code."
