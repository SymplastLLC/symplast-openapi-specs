      "Symplast_Appointments_Public_API_PublicAppointment": {
        "required": [
          "id",
          "updatedAt",
          "startsAt",
          "endsAt",
          "durationMinutes",
          "providerId",
          "locationId",
          "isDeleted",
          "isCancelled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Gets the appointment identifier (`AppointmentCalendarId`).",
            "format": "int32",
            "example": 1024
          },
          "updatedAt": {
            "type": "string",
            "description": "Gets the last-changed timestamp as a UTC Instant (serialized as ISO-8601 `Z`).\nThis is the change-feed watermark; a consumer resumes at `updatedSince = lastSeen − overlap`\nusing this value.",
            "format": "date-time",
            "example": "2026-01-15T14:30:00Z"
          },
          "startsAt": {
            "type": "string",
            "description": "Gets when the appointment starts as a UTC Instant (ISO-8601 `Z`). The naive\npractice-local wall-clock is interpreted in the location's timezone (DST honored at the\nappointment's own local time) and collapsed to this UTC point; clients render it in whatever zone\nthey choose. Falls back to treating the wall-clock as UTC when the location timezone is unavailable.",
            "format": "date-time",
            "example": "2026-01-20T14:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "description": "Gets when the appointment ends as a UTC Instant, using the same conversion as Instant PublicAppointment.StartsAt.",
            "format": "date-time",
            "example": "2026-01-20T14:30:00Z"
          },
          "durationMinutes": {
            "type": "integer",
            "description": "Gets the appointment duration in whole minutes (`End − Start`).",
            "format": "int32",
            "example": 30
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Gets the appointment status as a tenant-scoped LookupRef, or `null` when the\nstatus foreign key is null / unmatched (feed-complete LEFT JOIN).",
                "$ref": "#/components/schemas/Symplast_Appointments_Public_API_LookupRef"
              }
            ],
            "example": {
              "id": 5,
              "description": "Confirmed"
            }
          },
          "appointmentType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Gets the appointment type as a tenant-scoped LookupRef, or `null` when the\ntype foreign key is null / unmatched (feed-complete LEFT JOIN).",
                "$ref": "#/components/schemas/Symplast_Appointments_Public_API_LookupRef"
              }
            ],
            "example": {
              "id": 1,
              "description": "Consultation"
            }
          },
          "providerId": {
            "type": "integer",
            "description": "Gets the provider (physician) identifier.",
            "format": "int32",
            "example": 42
          },
          "locationId": {
            "type": "integer",
            "description": "Gets the location (branch) identifier.",
            "format": "int32",
            "example": 7
          },
          "patientId": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Gets the raw patient identifier, or `null` when no patient is assigned. PHI under BAA +\naudit (tokenization dropped for v1).",
            "format": "int32",
            "example": 88231
          },
          "isDeleted": {
            "type": "boolean",
            "description": "Gets a value indicating whether the appointment is deleted (indicator, not filtered out).",
            "example": false
          },
          "isCancelled": {
            "type": "boolean",
            "description": "Gets a value indicating whether the appointment is cancelled (indicator, not filtered out).",
            "example": false
          }
        },
        "description": "The PHI-minimized public projection of an appointment for third-party reporting integrations.",
        "example": {
          "id": 1024,
          "updatedAt": "2026-01-15T14:30:00Z",
          "startsAt": "2026-01-20T14:00:00Z",
          "endsAt": "2026-01-20T14:30:00Z",
          "durationMinutes": 30,
          "status": {
            "id": 5,
            "description": "Confirmed"
          },
          "appointmentType": {
            "id": 1,
            "description": "Consultation"
          },
          "providerId": 42,
          "locationId": 7,
          "patientId": 88231,
          "isDeleted": false,
          "isCancelled": false
        }
      },
