  "components": {
    "schemas": {
      "Symplast_Appointments_Public_API_AppointmentPurposeLookup": {
        "required": [
          "id",
          "description",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 2
          },
          "description": {
            "type": "string",
            "example": "New Patient"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          }
        },
        "description": "An appointment purpose vocabulary entry (tenant-scoped).",
        "example": {
          "id": 2,
          "description": "New Patient",
          "isDeleted": false
        }
      },
      "Symplast_Appointments_Public_API_AppointmentStageLookup": {
        "required": [
          "stageType",
          "description",
          "statusIds"
        ],
        "type": "object",
        "properties": {
          "stageType": {
            "type": "string",
            "example": "Scheduled"
          },
          "description": {
            "type": "string",
            "example": "Scheduled stage"
          },
          "statusIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "example": [
              5,
              6
            ]
          }
        },
        "description": "An appointment stage vocabulary entry (couples to statuses).",
        "example": {
          "stageType": "Scheduled",
          "description": "Scheduled stage",
          "statusIds": [
            5,
            6
          ]
        }
      },
      "Symplast_Appointments_Public_API_AppointmentStatusLookup": {
        "required": [
          "id",
          "name",
          "description",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "Confirmed"
          },
          "description": {
            "type": "string",
            "example": "Appointment confirmed by the patient"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          }
        },
        "description": "An appointment status vocabulary entry from per-tenant `StatusMaster`.",
        "example": {
          "id": 5,
          "name": "Confirmed",
          "description": "Appointment confirmed by the patient",
          "isDeleted": false
        }
      },
      "Symplast_Appointments_Public_API_AppointmentTypeLookup": {
        "required": [
          "id",
          "description",
          "durationInMinutes",
          "isDeleted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "description": {
            "type": "string",
            "example": "Consultation"
          },
          "durationInMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32",
            "example": 30
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          }
        },
        "description": "An appointment type vocabulary entry (tenant-scoped).",
        "example": {
          "id": 1,
          "description": "Consultation",
          "durationInMinutes": 30,
          "isDeleted": false
        }
      },
      "Symplast_Appointments_Public_API_LookupRef": {
        "required": [
          "id",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The lookup identifier (tenant-scoped).",
            "format": "int32",
            "example": 5
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "The lookup description; `null` when the source description is null.",
            "example": "Confirmed"
          }
        },
        "description": "A tenant-scoped reference to a lookup value, exposed as a stable-per-tenant id plus its human\ndescription. Used for LookupRef? PublicAppointment.Status and\nLookupRef? PublicAppointment.AppointmentType. The id is NOT stable across tenants.",
        "example": {
          "id": 5,
          "description": "Confirmed"
