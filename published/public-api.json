        "security": [
          {
            "Symplast_Legacy_Public_API_Bearer": []
          }
        ]
      }
    },
    "/v1/offices": {
      "get": {
        "tags": [
          "Symplast_Legacy_Public_API_Offices"
        ],
        "summary": "List the practice's offices.",
        "description": "Returns the practice's offices as a bare JSON array. An office with no active staff assignment is not listed — inherited from the internal surface deliberately, so the two agree. address.state, address.country and address.line2 are always null for offices, and offices carry no fax field.",
        "operationId": "ListOffices",
        "responses": {
