    "/v1/locations": {
      "get": {
        "tags": [
          "Symplast_Legacy_Public_API_Locations"
        ],
        "summary": "List the practice's locations.",
        "description": "Returns every active location for the authenticated tenant as a bare JSON array. Soft-deleted locations are excluded. A location whose parent office is absent, soft-deleted, or unstaffed is still returned, with a null officeId.",
        "operationId": "ListLocations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Symplast_Legacy_Public_API_PublicLocation"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Symplast_Legacy_Public_API_Bearer": []
          }
        ]
      }
    },
    "/v1/locations/{id}": {
      "get": {
        "tags": [
          "Symplast_Legacy_Public_API_Locations"
        ],
        "summary": "Get one location by id.",
        "description": "Returns 404 for an unknown id, a soft-deleted location, or an id belonging to another tenant — never 403, so the response cannot be used to probe for existence.",
        "operationId": "GetLocationById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifier of the resource. Non-integer values are rejected by the route constraint and answered with 404, never 400.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
