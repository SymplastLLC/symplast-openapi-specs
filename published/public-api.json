  "paths": {
    "/v1/appointments": {
      "get": {
        "tags": [
          "Symplast_Appointments_Public_API_Appointments"
        ],
        "summary": "List appointments",
        "description": "Returns a cursor-paged feed of the caller's tenant appointments, newest changes first.\nPass `updatedSince` (UTC) to scope by change time and `pageSize` to size the page; follow\nthe `next` link (an opaque `cursor`) to page. Delivery is at-least-once — dedupe on `id`.",
        "operationId": "GetAppointments",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_PagedResponsePublicAppointment"
                },
                "example": {
                  "data": [
                    {
                      "id": 1024,
                      "updatedAt": "2026-01-15T14:30:00Z",
                      "startsAt": "2026-01-20T14:00:00Z",
                      "endsAt": "2026-01-20T14:30:00Z",
                      "durationMinutes": 30,
                      "status": {
                        "id": 5,
                        "description": "Confirmed"
                      },
                      "appointmentType": {
                        "id": 1,
                        "description": "Consultation"
                      },
                      "providerId": 42,
                      "locationId": 7,
                      "patientId": 88231,
                      "isDeleted": false,
                      "isCancelled": false
                    }
                  ],
                  "pageSize": 50,
                  "count": 1,
                  "hasMore": false,
                  "nextCursor": null,
                  "next": null
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/invalid-cursor",
                  "title": "Invalid cursor",
                  "status": 400,
                  "detail": "The supplied cursor could not be decoded.",
                  "code": "invalid-cursor"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/unauthenticated",
                  "title": "Unauthenticated",
                  "status": 401,
                  "detail": "A valid gateway token is required to access this resource.",
                  "code": "unauthenticated"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/internal-error",
                  "title": "Internal server error",
                  "status": 500,
                  "detail": "An unexpected error occurred.",
                  "code": "internal-error"
                }
              }
            }
          }
        },
        "security": [
          {
            "Symplast_Appointments_Public_API_Bearer": []
          }
        ]
      }
    },
    "/v1/appointments/{id}": {
      "get": {
        "tags": [
          "Symplast_Appointments_Public_API_Appointments"
        ],
        "summary": "Get an appointment by id",
        "description": "Returns a single appointment by its identifier, scoped to the caller's tenant. An id that\ndoes not exist in the tenant returns 404 (a cross-tenant id is indistinguishable from a\nmissing one — no disclosure).",
        "operationId": "GetAppointmentById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The appointment identifier, unique within the caller's tenant.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_PublicAppointment"
                },
                "example": {
                  "id": 1024,
                  "updatedAt": "2026-01-15T14:30:00Z",
                  "startsAt": "2026-01-20T14:00:00Z",
                  "endsAt": "2026-01-20T14:30:00Z",
                  "durationMinutes": 30,
                  "status": {
                    "id": 5,
                    "description": "Confirmed"
                  },
                  "appointmentType": {
                    "id": 1,
                    "description": "Consultation"
                  },
                  "providerId": 42,
                  "locationId": 7,
                  "patientId": 88231,
                  "isDeleted": false,
                  "isCancelled": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/unauthenticated",
                  "title": "Unauthenticated",
                  "status": 401,
                  "detail": "A valid gateway token is required to access this resource.",
                  "code": "unauthenticated"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/not-found",
                  "title": "Not found",
                  "status": 404,
                  "detail": "The requested appointment does not exist in this tenant.",
                  "code": "not-found"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457 problem details).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Symplast_Appointments_Public_API_ProblemDetails"
                },
                "example": {
                  "type": "https://api.symplast.com/problems/appointments/internal-error",
                  "title": "Internal server error",
                  "status": 500,
                  "detail": "An unexpected error occurred.",
                  "code": "internal-error"
                }
              }
            }
          }
        },
        "security": [
          {
            "Symplast_Appointments_Public_API_Bearer": []
          }
        ]
      }
    },
